/* Brody AI · Diff Review · dark accent #00d2ff */
.drv-root {
    background-color: #0A0F1E;
    flex-grow: 1;
    flex-direction: column;
}

/* ── Header ── */
.drv-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    background-color: #0D1424;
    border-bottom-width: 1px;
    border-bottom-color: #1E2D4A;
    flex-shrink: 0;
}
.drv-header-title {
    color: #00d2ff;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 12px;
    white-space: nowrap;
}
.drv-file {
    color: #F1F5F9;
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.drv-nav { color: #64748B; font-size: 11px; margin-right: 8px; white-space: nowrap; }
.drv-nav-btn {
    background-color: #1A2540;
    border-width: 0;
    color: #94A3B8;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 4px;
    margin-left: 4px;
    white-space: nowrap;
}
.drv-nav-btn:hover { background-color: #2563EB; color: #ffffff; }

/* ── Summary / apply bar ── */
.drv-summary {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 14px;
    background-color: #111827;
    border-bottom-width: 1px;
    border-bottom-color: #1E2D4A;
    flex-shrink: 0;
}
.drv-summary-text { color: #CBD5E1; font-size: 11px; flex-grow: 1; margin-right: 10px; }
.drv-apply-btn {
    background-color: #14532D;
    color: #86EFAC;
    border-width: 0;
    padding: 5px 14px;
    border-radius: 5px;
    font-size: 12px;
    -unity-font-style: bold;
    flex-shrink: 0;
}
.drv-apply-btn:hover { background-color: #16803C; color: #ffffff; }
.drv-apply-btn--disabled { background-color: #1E2D4A; color: #64748B; }

/* ── Panes ── */
.drv-panes { flex-direction: row; flex-grow: 1; overflow: hidden; }
.drv-pane { flex-grow: 1; flex-direction: column; min-width: 0; }
.drv-pane-header {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 4px 10px;
    flex-shrink: 0;
}
.drv-before-header { color: #F87171; background-color: rgba(127, 29, 29, 0.35); border-bottom-width: 1px; border-bottom-color: #1E2D4A; }
.drv-after-header  { color: #4ADE80; background-color: rgba(20, 83, 45, 0.35); border-bottom-width: 1px; border-bottom-color: #1E2D4A; }
.drv-divider { width: 1px; background-color: #1E2D4A; flex-shrink: 0; }

.drv-scroll { flex-grow: 1; background-color: #060A14; }

/* ── A single side-by-side diff row ── */
.drv-row { flex-direction: row; }
.drv-gutter { width: 40px; background-color: #0D1424; flex-shrink: 0; }
.drv-gutter-text {
    color: #4A6080;
    font-size: 11px;
    -unity-text-align: middle-right;
    padding-right: 6px;
    white-space: nowrap;
    -unity-font-style: normal;
}
.drv-line { flex-grow: 1; }
.drv-line-text {
    font-size: 12px;
    color: #CBD5E1;
    padding-left: 8px;
    white-space: nowrap;
    overflow: hidden;
}

/* unchanged */
.drv-row--same .drv-line { background-color: #060A14; }
/* deletion (left / before) */
.drv-row--del .drv-line { background-color: rgba(127, 29, 29, 0.35); }
.drv-row--del .drv-line-text { color: #FCA5A5; }
/* addition (right / after) */
.drv-row--add .drv-line { background-color: rgba(20, 83, 45, 0.35); }
.drv-row--add .drv-line-text { color: #86EFAC; }
/* hunk marker row */
.drv-hunk-row {
    flex-direction: row;
    align-items: center;
    background-color: #111827;
    border-bottom-width: 1px;
    border-bottom-color: #1E2D4A;
    padding: 3px 6px;
    flex-shrink: 0;
}
.drv-hunk-label { color: #94A3B8; font-size: 11px; margin-right: auto; white-space: nowrap; }
.drv-hunk-status { color: #64748B; font-size: 10px; margin-right: 8px; white-space: nowrap; }
.drv-accept-btn {
    background-color: #14532D;
    color: #86EFAC;
    border-width: 0;
    padding: 2px 10px;
    border-radius: 4px;
    font-size: 11px;
    margin-left: 6px;
}
.drv-accept-btn:hover { background-color: #16803C; color: #ffffff; }
.drv-reject-btn {
    background-color: #7F1D1D;
    color: #FCA5A5;
    border-width: 0;
    padding: 2px 10px;
    border-radius: 4px;
    font-size: 11px;
    margin-left: 6px;
}
.drv-reject-btn:hover { background-color: #B91C1C; color: #ffffff; }
.drv-accept-btn--done, .drv-reject-btn--done { background-color: #1E2D4A; color: #64748B; }
.drv-rejected .drv-line { background-color: transparent; }
.drv-rejected .drv-line-text { color: #4A6080; }